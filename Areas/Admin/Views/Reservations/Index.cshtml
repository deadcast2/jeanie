@model jeanie.Models.ReservationViewModel
@{
    ViewBag.Title = "Reservations";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@ViewBag.Title</h2>
<hr />

<div class="md-margin-top">
    <div class="row">
        <div class="col-lg-12">
            @Html.Partial("_FormErrors", Model)
            <form method="post" action="@Url.Action("create")" class="md-margin-bottom form-inline pull-left">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <input class="form-control" style="min-width:250px;" name="name" value="@Model.Name" placeholder="Name Required" />
                </div>
                <button type="submit" class="btn btn-success">
                    <i class="glyphicon glyphicon-plus"></i> Add Reservation
                </button>
            </form>
            <table id="reservations_grid" class="table table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Grade</th>
                        <th>Time Slot</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th class="no-sort"></th>
                    </tr>
                </thead>              
            </table>
        </div>
    </div>
</div>

@section scripts {
    <script>$(JRS.Admin.Reservation.init)</script>
}