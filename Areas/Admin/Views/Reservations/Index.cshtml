@model jeanie.Models.ReservationViewModel
@{
    ViewBag.Title = "Reservations";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@ViewBag.Title</h2>
<hr />

<div class="md-margin-top">
    <div class="row">
        <div class="col-lg-12">
            @Html.Partial("_FormErrors", Model)
            <form method="post" action="@Url.Action("create")" class="md-margin-bottom form-inline pull-left">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <input class="form-control" style="min-width:250px;" name="name" value="@Model.Name" placeholder="Name Required" />
                </div>
                <button type="submit" class="btn btn-primary">
                    <i class="glyphicon glyphicon-plus"></i> Add Reservation
                </button>
            </form>
            <table id="reservations_grid" class="table table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Grade</th>
                        <th>Time Slot</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th class="no-sort"></th>
                    </tr>
                </thead>              
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="email_modal" data-path="@Url.Action("Show", "Email")" tabindex="-1" role="dialog" aria-labelledby="email_label">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <form method="post" action="@Url.Action("Create", "Email")">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" id="email_label">Review email before sending</h4>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <input type="email" name="To" class="form-control" placeholder="Send to email address..." required />
                    </div>
                    <textarea id="email_template" name="Body"></textarea>
                    <p class="help-block">A copy will be forwarded to @Mailer.DefaultEmail</p>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">
                        <i class="glyphicon glyphicon-send"></i> Send
                    </button>
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts {
    <script>$(JRS.Admin.Reservation.init)</script>
}