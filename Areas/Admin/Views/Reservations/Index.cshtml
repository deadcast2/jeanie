@model (jeanie.Models.ReservationViewModel, List<jeanie.Models.ReservationViewModel>)
@{
    ViewBag.Title = "Admin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@ViewBag.Title</h2>

<div class="md-margin">
    <div class="row">
        <div class="col-lg-4">
            <form method="post" action="@Url.Action("create")">
                @Html.AntiForgeryToken()

                @if (Model.Item1.Errors.Count > 0)
                {
                    <div class="alert alert-danger">
                        <ul>
                            @foreach (var error in Model.Item1.Errors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </div>
                }
                <div class="form-group">
                    <label>Name</label>
                    <input class="form-control" name="name" value="@Model.Item1.Name" placeholder="Required" />
                </div>
                <button type="submit" class="btn btn-success">
                    <i class="glyphicon glyphicon-plus"></i> Add Reservation
                </button>
            </form>
        </div>
        <div class="col-lg-8">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Grade</th>
                        <th>Time Slot</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reservation in Model.Item2)
                    {
                        <tr>
                            <td>@reservation.Name</td>
                            <td>@reservation.Grade</td>
                            <td>@reservation.StartDate</td>
                            <td><a href="@reservation.Url" class="copy" data-toggle="tooltip" data-placement="top" title="Copied to clipboard!">Copy Link</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
