@model (jeanie.Models.ReservationViewModel, List<jeanie.Models.ReservationViewModel>)
@{
    ViewBag.Title = "Reservations";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@ViewBag.Title</h2>
<hr/>

<div class="md-margin">
    <div class="row">
        <div class="col-lg-4">
            <form method="post" action="@Url.Action("create")">
                @Html.AntiForgeryToken()
                @Html.Partial("_FormErrors", Model.Item1)
                <div class="form-group">
                    <label>Name</label>
                    <input class="form-control" name="name" value="@Model.Item1.Name" placeholder="Required" />
                </div>
                <button type="submit" class="btn btn-success">
                    <i class="glyphicon glyphicon-plus"></i> Add Reservation
                </button>
            </form>
        </div>
        <div class="col-lg-8">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Grade</th>
                        <th>Time Slot</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reservation in Model.Item2)
                    {
                        <tr class="@reservation.StatusClass">
                            <td>@reservation.Name</td>
                            <td>@reservation.Grade.Preview(20)</td>
                            <td>@reservation.FormattedTimeSlot</td>
                            <td>@reservation.StatusText</td>
                            <td>
                                <form method="post" action="@Url.Action("Destroy")">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@reservation.Id" />
                                    <a href="@Url.Action("Edit", new { id = reservation.Id })" class="btn btn-default btn-sm">Edit</a>
                                    <a href="#copy" class="btn btn-default btn-sm copy" data-toggle="tooltip" data-placement="top"
                                       title="Copied to clipboard!" data-clipboard-text="@reservation.Url">Copy Link</a>
                                    <a href="#delete" class="btn btn-danger btn-sm delete-confirm">Delete</a>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (Model.Item2.Count == 0)
            {
                <div class="text-center">
                    No reservations created yet
                </div>
            }
        </div>
    </div>
</div>
