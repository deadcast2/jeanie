@model jeanie.Models.SettingViewModel
@{
    ViewBag.Title = "Settings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@ViewBag.Title</h2>
<hr />

<div class="md-margin-top">
    <form method="post" action="@Url.Action("Update")">
        @Html.AntiForgeryToken()
        @Html.Partial("_FormErrors", Model)
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label for="DailyReservationLimit">Daily Reservation Limit</label>
                    <input type="number" class="form-control" value="@Model.DailyReservationLimit" name="DailyReservationLimit" />
                    <p class="help-block">Leave blank to remove daily limit.</p>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-8">
                <div class="form-group">
                    <label for="EmailTemplate">Email Template</label>
                    <textarea class="form-control" id="EmailTemplate" name="EmailTemplate">@Model.EmailTemplate</textarea>
                    <p class="help-block">Special keyword #reservation-link will be replaced with actual link to the reservation.</p>
                </div>
            </div>
        </div>
        <button type="submit" class="btn btn-success"><i class="glyphicon glyphicon-ok"></i> Save Changes</button>
        <a href="@Url.Action("Index", "Reservations")" class="btn btn-default">Go Back</a>
    </form>
</div>

@section scripts {
    <script>
        $(function(){
            $('#EmailTemplate').summernote({
                height: 300
            });
        });
    </script>
}
