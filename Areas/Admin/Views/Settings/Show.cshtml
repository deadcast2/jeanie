@model jeanie.Models.Setting
@{
    ViewBag.Title = "Settings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@ViewBag.Title</h2>
<hr />

<div class="md-margin-top">
    <form method="post" action="@Url.Action("Update")">
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label for="DailyReservationLimit">Daily Reservation Limit</label>
                    <input type="number" class="form-control" value="@Model.DailyReservationLimit" name="DailyReservationLimit" />
                </div>
            </div>
        </div>
        <button type="submit" class="btn btn-success"><i class="glyphicon glyphicon-ok"></i> Save Changes</button>
        <a href="@Url.Action("Index", "Reservations")" class="btn btn-default">Go Back</a>
    </form>
</div>
