@model jeanie.Models.ReservationViewModel
@{
    ViewBag.Title = "Book Reservation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="md-margin">
    <form id="reservation_form" method="post" action="@Url.Action("Update")">
        @Html.AntiForgeryToken()
        @Html.Partial("_FormErrors", Model)
        <input type="hidden" name="id" value="@Model.Id" />
        <h2>Step 1 - Pick a Time</h2>
        <hr />
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label for="date">Date</label>
                    <input id="date" name="date" type="text" class="form-control pickadate"
                           placeholder="Required" value="@(Model.Date?.ToShortDateString())" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label for="time_slot">Time Slot</label>
                    <select id="time_slot" name="timeslot" class="form-control">
                        <option value="">Please select a date first</option>
                    </select>
                </div>
            </div>
        </div>
        <h2>Step 2 - Your Details</h2>
        <hr />
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label for="grade">Grade</label>
                    <input id="grade" name="grade" type="text" class="form-control" placeholder="Required" value="@Model.Grade" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label for="notes">Notes</label>
                    <textarea id="notes" name="notes" class="form-control" placeholder="Optional">@Model.Notes</textarea>
                </div>
            </div>
        </div>
        <button type="submit" class="btn btn-success">
            <i class="glyphicon glyphicon-ok"></i> Book Reservation
        </button>
    </form>
</div>

<div class="modal fade" id="confirm_modal" tabindex="-1" role="dialog" aria-labelledby="confirm_label">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="confirm_label">Review your details</h4>
            </div>
            <div class="modal-body">
                <div id="recap"></div>
            </div>
            <div class="modal-footer">
                <button type="button" id="confirm" class="btn btn-success"><i class="glyphicon glyphicon-thumbs-up"></i> Yes, I Confirm</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>

<script id="recap_template" type="text/x-jsrender">
    <p>You would like to make a reservation for <b>{{:date}}</b> from <b>{{:time}}</b>?</p>
</script>

@section scripts {
    <script>
        $(function () {
            JRS.Reservation.init('@Model.TimeSlot');
        });
    </script>
}
