@model jeanie.Models.ReservationViewModel
@{
    ViewBag.Title = "Book Reservation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="md-margin">
    <form method="post" action="@Url.Action("Update")">
        <input type="hidden" name="id" value="@Model.Id" />
        <h2>Step 1 - Pick a Time</h2>
        <hr />
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label for="date">Date</label>
                    <input id="date" name="date" type="text" class="form-control pickadate" placeholder="Required" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label for="time_slot">Time Slot</label>
                    <select id="time_slot" name="timeslot" class="form-control">
                        <option>9:00 am - 12:00 pm</option>
                        <option>10:00 am - 1:00 pm</option>
                    </select>
                </div>
            </div>
        </div>
        <h2>Step 2 - About You</h2>
        <hr />
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label for="grade">Grade</label>
                    <input id="grade" name="grade" type="text" class="form-control" placeholder="Required" />
                </div>
            </div>
            <div class="form-group">
                <label for="notes">Notes</label>
                <textarea id="notes" name="notes" class="form-control" placeholder="Optional"></textarea>
            </div>
        </div>     
        <button type="submit" class="btn btn-success"><i class="glyphicon glyphicon-ok"></i> Book Reservation</button>
    </form>
</div>

@section scripts {
    <script>
        $(function () {
            $('.pickadate').pickadate();
        });
    </script>
}
